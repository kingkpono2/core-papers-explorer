{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/core-papers-explorer/browser",
  "functions": {
    "api/core-search.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/core-api/v3/search/works/", "destination": "/api/core-search" },
    { "source": "/core-api/(.*)", "destination": "/api/core-search" },
    { "source": "/((?!core-api/|api/|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
